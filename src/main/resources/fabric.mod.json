{
	"schemaVersion": 1,
	"id": "infernum",
	"version": "${version}",
	"name": "Infernum",
	"description": "Fun lil skyblock mod",
	"authors": [
		"Enrico"
	],
	"contact": {
		"homepage": "https://www.frozencloud.dev",
		"sources": "https://github.com/spookie6/frozen-fabric"
	},
	"license": "CC0-1.0",
	"icon": "assets/infernum/infernum-icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			{
				"value": "dev.frozencloud.infernum.Infernum",
				"adapter": "kotlin"
			}
		],
        "modmenu": [
          {
            "adapter": "kotlin",
            "value": "dev.frozencloud.infernum.compat.ModMenuCompat"
          }
        ]
	},
	"mixins": [
      "infernum.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}